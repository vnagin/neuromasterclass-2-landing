    {
      "id": "f3b926ad-afdc-4592-8717-84130cdb4f56",
      "name": "LLM — классификация (Message a model)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        680,
        320
      ],
      "parameters": {
        "resource": "text",
        "operation": "response",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "gpt-4o-mini"
        },
        "responses": {
          "values": [
            {
              "type": "text",
              "role": "user",
              "content": "=Роль: ты — ассистент отдела обработки входящих обращений.\nЗадача: проанализируй текст обращения и верни структурированный результат.\nПравила:\n- Если данных нет — ставь null, не выдумывай.\n- priority: one of [\"high\",\"medium\",\"low\"].\n- category: one of [\"горячий\",\"тёплый\",\"спам\",\"другое\"].\nФормат: верни ТОЛЬКО валидный JSON, без пояснений и без markdown:\n{\"category\": \"...\", \"priority\": \"...\", \"client_name\": \"...|null\", \"summary\": \"...\", \"draft_reply\": \"...\"}\n\nТекст обращения: {{ $json.message_text }}"
            }
          ]
        },
        "simplify": true,
        "options": {
          "temperature": 0.2,
          "maxTokens": 1024
        }
      }
    },
    {
      "id": "2ad9b791-0218-4ae7-b0a1-986950e62fc2",
      "name": "Парс JSON-ответа",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        320
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const raw = $json.content ?? $json.output_text ?? $json.text ?? $json.message ?? '';\nlet txt = typeof raw === 'string' ? raw : JSON.stringify(raw);\ntxt = txt.trim().replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();\nlet p;\ntry { p = JSON.parse(txt); }\ncatch (e) { p = { category: 'другое', priority: 'low', client_name: null, summary: txt.slice(0, 500), draft_reply: '', parse_error: true }; }\nconst src = $('Нормализация входа').item.json;\nreturn {\n  category: p.category ?? null,\n  priority: p.priority ?? null,\n  client_name: p.client_name ?? null,\n  summary: p.summary ?? null,\n  draft_reply: p.draft_reply ?? null,\n  client_email: src.client_email ?? '',\n  source: src.source ?? 'webhook',\n  received_at: src.received_at ?? '',\n  raw_message: src.message_text ?? ''\n};"
      }
    },
